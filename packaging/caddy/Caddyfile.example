# sadbox behind Caddy on the Mac mini (home server).
#
# sadbox runs NATIVELY on the Mac mini (it needs Apple Virtualization.framework
# via `container` — never in Docker) and binds localhost:7070. Caddy, already on
# the same box, is the only thing exposed to the network. Add this block to your
# Caddyfile, adjust the hostname, then `caddy reload`.
#
#   - WebSocket (the browser terminal) is proxied automatically by Caddy v2.
#   - `flush_interval -1` keeps the SSE network-activity feed streaming.
#   - sadbox has NO auth of its own — protect it here (or with Tailscale /
#     forward_auth). It can create/destroy VMs and open shells, so don't expose
#     it unauthenticated on your LAN.
#   - Only port 7070 is routed. Port 7071 is the VMs' internal egress proxy on
#     the vmnet gateway (192.168.64.1) — leave it alone, never proxy it.
#   - Use a dedicated hostname (or root), not a subpath: sadbox serves from "/".

sadbox.home.arpa {
	# LAN TLS: Caddy issues an internal cert — run `caddy trust` (or import
	# Caddy's root CA) on each client machine so browsers accept it. Or swap in
	# your own domain + real certs, or drop this line to serve plain http://.
	tls internal

	# Generate the hash with:  caddy hash-password
	# (older Caddy: the directive is `basicauth`, not `basic_auth`)
	basic_auth {
		admin $2a$14$REPLACE_WITH_BCRYPT_HASH
	}

	reverse_proxy 127.0.0.1:7070 {
		flush_interval -1  # stream SSE (live network feed) without buffering
	}
}

# sadbox behind Caddy on the Mac mini (home server).
#
# sadbox runs NATIVELY on the Mac mini (it needs Apple Virtualization.framework
# via `container` — never in Docker) and listens on 127.0.0.1:7070. Run it with
# SADBOX_HOST=127.0.0.1: Bun's `localhost` binds ::1 only on macOS, and an IPv4
# reverse proxy (or colima's host address) then gets connection refused. Caddy,
# already on the same box, is the only thing exposed to the network.
#
#   - Caddy in Docker/colima: `127.0.0.1` in reverse_proxy is Caddy's own
#     container. Use `host.docker.internal:7070` (Docker Desktop) or the host
#     address colima maps it to (usually 192.168.5.2); if the name does not
#     resolve, add `extra_hosts: ["host.docker.internal:192.168.5.2"]`.
#   - `dns cloudflare` needs a Caddy built with
#     github.com/caddy-dns/cloudflare — the official image and brew's caddy do
#     not include it. `zone_id` is not a supported option; scope the API token
#     to the zone instead.
#   - WebSocket (the browser terminal) is proxied automatically by Caddy v2.
#   - `flush_interval -1` keeps the SSE network-activity feed streaming.
#   - sadbox has its own password sign-in; basic_auth here (or Tailscale /
#     forward_auth) is an optional second layer. It can create/destroy VMs
#     and open shells, so always serve it over TLS.
#   - Only port 7070 is routed. Port 7071 is the egress proxy for older VMs
#     still on a network (it refuses anything else) — never proxy it.
#   - Use a dedicated hostname (or root), not a subpath: sadbox serves from "/".

# --- Option A: slot into an existing wildcard block (recommended) -------------
# If you already terminate TLS for a wildcard via the Cloudflare DNS challenge,
# route sadbox by host inside that block so it reuses the real (browser-trusted)
# wildcard cert — wss:// and SSE then work with no cert-trust steps on clients.
#
# *.internal.example.com {
#   tls {
#     dns cloudflare {env.CLOUDFLARE_API_TOKEN}
#   }
#
#   @sadbox host sadbox.internal.example.com
#   handle @sadbox {
#     basic_auth {
#       admin $2a$14$REPLACE_WITH_BCRYPT_HASH   # caddy hash-password
#     }
#     reverse_proxy 127.0.0.1:7070 {
#       flush_interval -1
#     }
#   }
#
#   # …your other per-host handle blocks…
# }

# --- Option B: a standalone site block ---------------------------------------
# If sadbox gets its own block, give it TLS too. With a real domain, reuse your
# DNS challenge; on a bare LAN name, `tls internal` works but each client must
# trust Caddy's root CA (`caddy trust`) or the terminal's wss will be rejected.

sadbox.internal.example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	basic_auth {
		admin $2a$14$REPLACE_WITH_BCRYPT_HASH   # caddy hash-password
	}

	reverse_proxy 127.0.0.1:7070 {   # Docker/colima: host.docker.internal:7070
		flush_interval -1  # stream SSE (live network feed) without buffering
	}
}
